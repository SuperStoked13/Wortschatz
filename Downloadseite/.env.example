# Einstellungen der Downloadseite. Kopiere diese Datei nach .env und fülle sie aus.
# (Docker Compose und der systemd-Dienst lesen .env; lokal kannst du die Werte auch
# vor den Befehl schreiben: SITE_ORIGIN=http://localhost:8080 node server/server.mjs)

# Adresse der Website, ohne Schrägstrich am Schluss
SITE_ORIGIN=https://wortschatz.duckdns.org

# DuckDNS: hält wortschatz.duckdns.org auf der aktuellen IP-Adresse deines Anschlusses.
# Den Token zeigt duckdns.org nach dem Login oben auf der Seite an. Leer lassen, wenn dein
# Router DuckDNS selbst aktualisiert.
DUCKDNS_DOMAIN=wortschatz
DUCKDNS_TOKEN=

# Erscheinen in der Datenschutzerklärung und im Footer (das Datenschutzgesetz verlangt,
# dass Besucher wissen, wer die Seite betreibt und wie man ihn erreicht).
OPERATOR_NAME=
CONTACT_EMAIL=

# Limits. Die Standardwerte passen für einen Heimanschluss; nur bei Bedarf ändern.
# Downloads pro Internetadresse (eine ganze Schule teilt sich oft eine Adresse). Jeder
# vollständige Download zählt, auch ein zweiter über denselben Link.
#DOWNLOADS_PER_HOUR=30
#DOWNLOADS_PER_DAY=100
# Höchstens so viele Gigabyte pro Internetadresse und Tag, 0 = ohne Grenze
#DAILY_TRAFFIC_GB_PER_IP=3
# Gleichzeitige Downloads
#CONCURRENT_DOWNLOADS_PER_IP=6
#CONCURRENT_DOWNLOADS_TOTAL=40
# Bandbreite in Megabit pro Sekunde (etwa 70 % deines Uploads), 0 = ohne Grenze
#BANDWIDTH_TOTAL_MBIT=50
#BANDWIDTH_PER_DOWNLOAD_MBIT=0
# Höchstens so viele Gigabyte pro Tag für alle zusammen, 0 = ohne Grenze
#DAILY_TRAFFIC_GB=50
# Ein Download, der nach der Schonfrist (Sekunden) langsamer läuft als DOWNLOAD_MIN_KBPS
# (Kilobyte pro Sekunde), wird abgebrochen und gibt seinen Platz frei. 0 = keine Prüfung.
# Kein Download dauert länger als DOWNLOAD_MAX_MINUTES.
#DOWNLOAD_MIN_KBPS=16
#DOWNLOAD_SLOW_GRACE_SECONDS=30
#DOWNLOAD_MAX_MINUTES=180
# Wie lange ein Download-Link gilt (Sekunden) und wie oft er benutzt werden darf
#DOWNLOAD_LINK_SECONDS=120
#DOWNLOAD_LINK_USES=3
# Seitenaufrufe pro Adresse: so viele auf einmal, danach so viele pro Minute
#RATE_PAGE_BURST=60
#RATE_PAGE_PER_MINUTE=60
# Dateien wie CSS, Skripte und Bilder pro Adresse (eine Seite braucht etwa ein Dutzend)
#RATE_ASSET_BURST=150
#RATE_ASSET_PER_MINUTE=300
# Sperre für Scanner und Angreifer (Strafpunkte bis zur Sperre, Dauer in Minuten)
#BAN_THRESHOLD=12
#BAN_MINUTES=60

# Für Fortgeschrittene
# Download-Links gelten nur für die Internetadresse, die sie angefordert hat (0 = für alle)
#DOWNLOAD_LINK_BIND_IP=1
# Welchem Proxy der Server die Besucheradresse glaubt: loopback (Caddy auf demselben
# Gerät) oder private (Docker; setzt compose.yaml schon)
#TRUST_PROXY=loopback
# Fester Schlüssel für die Download-Links (sonst neu bei jedem Start, mindestens 32 Zeichen)
#DOWNLOAD_SECRET=
# Protokoll: debug, info, warn, error oder silent; ACCESS_LOG=0 schaltet die Zeile pro Anfrage aus
#LOG_LEVEL=info
#ACCESS_LOG=1
