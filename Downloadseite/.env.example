# Einstellungen der Downloadseite. Kopiere diese Datei nach .env und fülle sie aus.
# (Docker Compose und der systemd-Dienst lesen .env; lokal kannst du die Werte auch
# vor den Befehl schreiben: SITE_ORIGIN=http://localhost:8080 node server/server.mjs)

# Adresse der Website, ohne Schrägstrich am Schluss
SITE_ORIGIN=https://wortschatz.duckdns.org

# DuckDNS: hält wortschatz.duckdns.org auf der aktuellen IP-Adresse deines Anschlusses.
# Den Token zeigt duckdns.org nach dem Login oben auf der Seite an. Leer lassen, wenn dein
# Router DuckDNS selbst aktualisiert.
DUCKDNS_DOMAIN=wortschatz
DUCKDNS_TOKEN=

# Erscheinen in der Datenschutzerklärung und im Footer (das Datenschutzgesetz verlangt,
# dass Besucher wissen, wer die Seite betreibt und wie man ihn erreicht).
OPERATOR_NAME=
CONTACT_EMAIL=

# Passwort für die ganze Website (mindestens 8 Zeichen, besser lang und zufällig). Die Seite zeigt
# dann eine Anmeldung mit nur einem Passwortfeld und merkt sie sich 90 Tage in einem Cookie.
# Leer = Seite öffentlich.
SITE_PASSWORD=

# Limits. Die Standardwerte passen für einen Heimanschluss; nur bei Bedarf ändern.
# Anfragen pro Internetadresse: so viele auf einmal, danach so viele pro Sekunde. Eine ganze
# Schule teilt sich oft eine Adresse, und ein erster Besuch sind etwa zehn Anfragen.
#RATE_REQUEST_BURST=1000
#RATE_REQUESTS_PER_SECOND=20
# Seiten, Dateien und Fehlerseiten, in Megabit pro Sekunde: pro Adresse und für alle zusammen
# (Downloads haben eigene Grenzen). Zusammen mit BANDWIDTH_TOTAL_MBIT unter dem echten Upload halten.
#SITE_BANDWIDTH_PER_IP_MBIT=0.5
#SITE_BANDWIDTH_MBIT=20
# Gleichzeitige Downloads (die Bandbreite unten gilt für alle zusammen)
#CONCURRENT_DOWNLOADS_PER_IP=12
#CONCURRENT_DOWNLOADS_TOTAL=200
# Bandbreite der Downloads in Megabit pro Sekunde (etwa 70 % deines Uploads), 0 = ohne Grenze
#BANDWIDTH_TOTAL_MBIT=50
#BANDWIDTH_PER_DOWNLOAD_MBIT=0
# Nach so vielen Gigabyte am Tag (für alle bzw. pro Adresse, 0 = ohne Grenze) teilen sich die
# betroffenen Downloads innerhalb von BANDWIDTH_TOTAL_MBIT eine langsame Spur statt aufzuhören,
# in Megabit pro Sekunde.
#DAILY_TRAFFIC_GB=50
#DAILY_TRAFFIC_GB_PER_IP=20
#DAILY_TRAFFIC_SLOW_MBIT=10
# Ein Download, der nach der Schonfrist (Sekunden) im Schnitt langsamer läuft als DOWNLOAD_MIN_KBPS
# (Kilobyte pro Sekunde), wird abgebrochen und gibt seinen Platz frei. 0 = keine Prüfung.
# Kein Download dauert länger als DOWNLOAD_MAX_MINUTES.
#DOWNLOAD_MIN_KBPS=16
#DOWNLOAD_SLOW_GRACE_SECONDS=30
#DOWNLOAD_MAX_MINUTES=180
# Wie lange ein Download-Link gilt (Sekunden) und wie oft er benutzt werden darf
#DOWNLOAD_LINK_SECONDS=120
#DOWNLOAD_LINK_USES=3
# Falsche Passwörter pro Adresse und Tag
#PASSWORD_GUESSES_PER_DAY=200

# Für Fortgeschrittene
# Download-Links gelten nur für die Internetadresse, die sie angefordert hat (0 = für alle)
#DOWNLOAD_LINK_BIND_IP=1
# Welchem Proxy der Server die Besucheradresse glaubt: loopback (Caddy auf demselben
# Gerät) oder private (Docker)
#TRUST_PROXY=loopback
# Fester Schlüssel für die Download-Links (sonst neu bei jedem Start, mindestens 32 Zeichen)
#DOWNLOAD_SECRET=
# Downloads auf GitHub: Manifeste mit "url" dürfen nur auf Release-Dateien dieses Repos zeigen
#DOWNLOAD_REPO=SuperStoked13/Wortschatz
# Zusätzlich eine Unix-Socket-Datei für den Proxy: Dann braucht der Container kein Netz
# (Docker network_mode: none), HOST:PORT bleibt nur für den Gesundheitscheck im Container.
#LISTEN_SOCKET=/run/wortschatz/web.sock
# Protokoll: debug, info, warn, error oder silent; ACCESS_LOG=0 schaltet die Zeile pro Anfrage aus
#LOG_LEVEL=info
#ACCESS_LOG=1
