<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native Windows app (Avalonia, Glas design). Built for Windows with build.sh; runs on Linux too (dev/tests).
       Two targets: net10.0-windows… is the real app (Windows APIs through the WinRT projection: text recognition with
       Windows.Media.Ocr, PDF rendering with Windows.Data.Pdf, code under #if WINDOWS); plain net10.0 is what the
       snapshot tool and headless checks on Linux use (those features report that they need Windows). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Wortschatz.App</RootNamespace>
    <AssemblyName>Wortschatz</AssemblyName>
    <Product>Wortschatz</Product>
    <Version>1.8.3</Version>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- An update test (tools/update-test.sh): a copy that trusts only this throwaway key and reads its releases from the
       folder update-test next to it (Services/AppUpdater.cs › TestKey). build.sh never sets it. -->
  <ItemGroup Condition="'$(UpdateTestKey)' != ''">
    <AssemblyMetadata Include="WortschatzUpdateTestKey" Value="$(UpdateTestKey)" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wortschatz.Core\Wortschatz.Core.csproj" />
  </ItemGroup>
</Project>
